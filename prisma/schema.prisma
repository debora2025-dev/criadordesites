generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  name        String?
  email       String       @unique
  password    String?
  createdAt   DateTime     @default(now())
  workspaces  Workspace[]
  generations Generation[]
}

model Workspace {
  id        String     @id @default(cuid())
  name      String
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  campaigns Campaign[]
  leads     Lead[]
  createdAt DateTime   @default(now())
}

model Campaign {
  id          String    @id @default(cuid())
  name        String
  platform    String
  objective   String
  status      String
  budget      Float?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
}

model Lead {
  id          String    @id @default(cuid())
  name        String
  email       String?
  phone       String?
  source      String?
  status      String
  notes       String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
}

model Generation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tool      String
  prompt    String   @db.Text
  output    String   @db.Text
  createdAt DateTime @default(now())
}
